# =============================================================================
# Sistema Hugo — variáveis de ambiente
# Copie para .env.local (dev) ou configure no Coolify (produção).
# =============================================================================

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- EvoGo / WhatsApp (obrigatório para envio de mensagens) ---
EVOGO_API_URL=https://evogo.iafeoficial.com
EVOGO_GLOBAL_API_KEY=
EVOGO_INSTANCE_NAME=
# Opcional se já souber id/token da instância (evita lookup em runtime):
EVOGO_INSTANCE_ID=
EVOGO_INSTANCE_TOKEN=
# Webhook reatado a cada connect (logout/disconnect apagam na EvoGo). Ex: https://n8n.seudominio.com/webhook/ia_hulgo_advocacia
EVOGO_WEBHOOK_URL=

# --- n8n (obrigatório para aprovações e controle da IA) ---
N8N_WEBHOOK_APROVACAO=https://n8n.seudominio.com/webhook/aprovacao
N8N_WEBHOOK_CONTROLE_IA=https://n8n.seudominio.com/webhook/controle-ia
# Sandbox Configurações → Testar agente (resposta final via AI Agent no n8n)
N8N_WEBHOOK_TESTE_IA=https://n8n-sgo8ksokg404ocg8sgc4sooc.vemprajogo.com/webhook/teste-ia-hulgoo
N8N_INTEGRACAO_TOKEN=token-secreto-para-apis-integracao

# --- Cron DataJud / limpeza sandbox / retenção assistente / prazos push ---
CRON_SECRET=gerar-string-aleatoria-longa

# --- Web Push (PWA) ---
# Gerar: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY também precisa estar em Build Variables no Coolify
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com
# Secret do webhook Database Webhooks do Supabase → POST /api/push/webhook
PUSH_WEBHOOK_SECRET=gerar-string-aleatoria-longa

# --- OpenAI — sandbox (Whisper/visão/doc) + assistente interno do painel (chat/tools) ---
# Assistente reutiliza as mesmas chaves; ver docs/ASSISTENTE-INTERNO.md
OPENAI_API_KEY=sk-...
# Opcional (padrão gpt-5.6-luna; "high" = reasoning effort, não o model id):
OPENAI_MODEL=gpt-5.6-luna
# Opcional (padrão whisper-1 para áudio no sandbox):
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- DataJud (opcional — há chave pública embutida no código) ---
DATAJUD_API_KEY=
